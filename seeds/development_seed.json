      {"key":"rental_prohibited_disqualifier","name":"Rentals prohibited","stage":"fit_check","priority":20,"status":"active","when":{"field":"rental_restrictions","operator":"equals","value":true},"then":[{"action":"disqualify","outcome":"not_currently_eligible"},{"action":"add_risk_flag","value":"rental_prohibited"},{"action":"add_reason","code":"RENTALS_PROHIBITED"}],"public_explanation":"Inventory with prohibited rentals is not currently eligible for Luxe Solara rental management.","internal_explanation":"Owner indicated resort or club rules prohibit rentals.","stop_processing":true},
      {"key":"preferred_destination","name":"Preferred destination seed","stage":"fit_check","priority":30,"status":"active","when":{"field":"destination","operator":"in","value":["los_cabos","puerto_vallarta","cancun","riviera_maya"]},"then":[{"action":"add_score","category":"inventory_fit","value":20},{"action":"add_tag","value":"preferred_destination"},{"action":"add_reason","code":"PREFERRED_DESTINATION"}],"public_explanation":"Your destination is currently in an initial priority market."},
      {"key":"enough_nights_paid_audit","name":"Enough nights seed threshold","stage":"fit_check","priority":40,"status":"active","when":{"all":[{"field":"nights_available","operator":"greater_than_or_equal","value":7},{"field":"destination","operator":"not_equals","value":"other"}]},"then":[{"action":"qualify_for_paid_audit"},{"action":"select_result_template","template_key":"qualified_paid_audit"}],"public_explanation":"The initial details support a deeper Paid Audit review."}
